{
  "name": "map-animations-kit",
  "version": "1.0.0",
  "description": "Declarative MapLibre + Playwright + ffmpeg renderer for map animation clips",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "validate:geo": "node scripts/validate-geo.mjs",
    "validate:scenes": "node scripts/validate-scene.mjs",
    "test": "npm run validate:geo && npm run validate:scenes",
    "render": "node render/render.mjs",
    "probe": "node tools/probe-frame.mjs",
    "camera-picker": "node tools/camera-picker/server.mjs"
  },
  "dependencies": {
    "maplibre-gl": "5.24.0",
    "playwright": "1.62.1",
    "pmtiles": "4.5.0"
  }
}
